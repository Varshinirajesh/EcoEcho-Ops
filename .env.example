# thresholds (see CLAUDE.md: keep these tunable, not hardcoded)
DRIFT_ALERT_THRESHOLD=0.5
CONFIDENCE_THRESHOLD=0.6

# storm simulation
STORM_MODE_ENABLED=false
STORM_NOISE_INTENSITY=0.6

# drift monitoring (Evidently, in inference-api)
DRIFT_WINDOW_SIZE=30

# minio (satellite-uplink stand-in)
# Local dev only: minioadmin/minioadmin is fine. Before any public deploy,
# change these to real generated secrets (minio never exposes 9000/9001
# publicly per docker-compose.prod.yml, but don't rely on that alone).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=ecoecho-uplink

# mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MODEL_REGISTRY_NAME=ecoecho-classifier
MODEL_POLL_INTERVAL_SECONDS=30

# grafana
# Same note as MINIO_ROOT_PASSWORD above — change before deploying publicly.
GRAFANA_ADMIN_PASSWORD=admin

# uplink batching
UPLINK_BATCH_SIZE=20
UPLINK_INTERVAL_SECONDS=300
